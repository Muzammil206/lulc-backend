# ============================================================
# LULC Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — add it to .gitignore
# ============================================================

# ── Google Earth Engine Service Account ─────────────────────
# Path to your downloaded service account JSON key file
# Get this from: console.cloud.google.com → IAM → Service Accounts
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=./gee-service-account.json

# ── Server ───────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# ── Frontend URL (for CORS) ──────────────────────────────────
# Local development
FRONTEND_URL=http://localhost:3000
# Production (add your Vercel URL here when deployed)
# FRONTEND_URL=https://your-app.vercel.app

# ── Cache settings ───────────────────────────────────────────
# How long to cache classification results in memory (seconds)
# 3600 = 1 hour. GEE computations are expensive — don't skip this
CACHE_TTL_SECONDS=3600

# ── GEE Computation settings ─────────────────────────────────
# Max cloud cover % for Landsat scene pre-filtering
MAX_CLOUD_COVER=30
# Default AOI buffer radius in metres around a point
DEFAULT_BUFFER_METRES=15000
